# ============================================================
# QA Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# --- Gemini (Google AI Studio) ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for generation
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated list of fallback models tried when the primary is overloaded (503/429).
# Leave empty to disable fallback. Recommended: gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# Gemini model to use for embeddings (RAG)
# Used when GEMINI_API_KEY is set.  When not set, a local model
# (all-MiniLM-L6-v2 bundled with ChromaDB) is used automatically — no API key needed.
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Groq (cross-provider fallback or primary) ---
# Get your free API key at: https://console.groq.com/keys
# When GEMINI_API_KEY is set, Groq is tried as a last resort after all Gemini models fail.
# When GEMINI_API_KEY is not set, Groq is used as the sole provider.
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use — see https://console.groq.com/docs/models for current options
GROQ_MODEL=openai/gpt-oss-120b

# --- GitHub Integration ---
# Personal access token with scope: repo (issues read/write)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Target repo in "owner/repo" format, e.g. my-org/qa-agent
GITHUB_REPO=your_github_username/your_repo_name

# --- Agent Loop ---
# Maximum number of plan→run→analyze iterations before handing off to human
MAX_AGENT_ITERATIONS=3

# --- ChromaDB ---
# Directory where the persistent ChromaDB collection is stored
CHROMA_PERSIST_DIR=evidence/chroma_db

# Name of the ChromaDB collection for the RAG corpus
CHROMA_COLLECTION_NAME=qa_agent_corpus

# --- Docker Sandbox ---
# Docker image used for sandboxed test execution
DOCKER_IMAGE=python:3.11-slim

# Timeout in seconds for each test run inside Docker
DOCKER_TIMEOUT=30

# --- Persistent Memory ---
# Path to the SQLite database for run history and drafted issues
MEMORY_DB_PATH=evidence/qa_agent.db

# --- Logging ---
# Path to the JSON-lines structured log file
LOG_FILE=evidence/traces/app.log

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
